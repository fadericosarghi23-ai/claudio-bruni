---
/**
 * StudioNumeri — fascia scura con i numeri dello studio (home e pagina Studio).
 *
 * Animazione, una volta sola quando la fascia entra a schermo:
 * - la linea sopra ogni numero si disegna da sinistra (CSS, classe .is-on);
 * - i valori numerici contano da 0 al valore finale, con easing e sfasamento per colonna;
 * - i valori testuali (es. "CTU") si compongono con un effetto di decodifica.
 * Nell'HTML c'è sempre il valore finale: senza JS o con prefers-reduced-motion si vede quello.
 */
import { STUDIO } from '../lib/studio';

const NUMERI = [
  { v: STUDIO.fondazione, l: 'nascita dello studio' },
  { v: '6', l: 'servizi offerti' },
  { v: String(STUDIO.zone.length), l: 'province servite' },
  { v: 'CTU', l: 'Tribunale di Imperia' },
];
---

<section class="stproof on-dark" data-numeri>
  <div class="container stproof__grid">
    {NUMERI.map((p, i) => (
      <div class="stproof__item" style={`--i:${i}`}>
        <strong data-valore={p.v}>{p.v}</strong>
        <span>{p.l}</span>
      </div>
    ))}
  </div>
</section>

<script>
  const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const LETTERE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

  function conta(el: HTMLElement, fine: number, ritardo: number) {
    const durata = 1800;
    el.textContent = '0';
    setTimeout(() => {
      const t0 = performance.now();
      const passo = (ora: number) => {
        const p = Math.min(1, (ora - t0) / durata);
        el.textContent = String(Math.round(fine * easeOut(p)));
        if (p < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    }, ritardo);
  }

  function decodifica(el: HTMLElement, testo: string, ritardo: number) {
    const durata = 1100;
    el.textContent = testo.replace(/./g, ' ');
    setTimeout(() => {
      const t0 = performance.now();
      const passo = (ora: number) => {
        const p = Math.min(1, (ora - t0) / durata);
        const fisse = Math.floor(testo.length * easeOut(p));
        el.textContent = [...testo]
          .map((c, k) => (k < fisse ? c : LETTERE[Math.floor(Math.random() * LETTERE.length)]))
          .join('');
        if (p < 1) requestAnimationFrame(passo);
        else el.textContent = testo;
      };
      requestAnimationFrame(passo);
    }, ritardo);
  }

  document.querySelectorAll<HTMLElement>('[data-numeri]').forEach((sez) => {
    let partita = false;
    const avvia = () => {
      if (partita) return;
      partita = true;
      sez.classList.add('is-on');
      if (ridotto) return;
      sez.querySelectorAll<HTMLElement>('[data-valore]').forEach((el, i) => {
        const v = el.dataset.valore || '';
        const ritardo = 150 + i * 140;
        if (/^\d+$/.test(v)) conta(el, Number(v), ritardo);
        else decodifica(el, v, ritardo);
      });
    };
    // rete di sicurezza: se l'observer non scatta, parte comunque allo scroll o al load
    const aSchermo = () => {
      const r = sez.getBoundingClientRect();
      if (r.top < innerHeight * 0.85 && r.bottom > 0) avvia();
    };
    addEventListener('scroll', aSchermo, { passive: true });
    addEventListener('load', aSchermo);
    if (!('IntersectionObserver' in window)) return avvia();
    const io = new IntersectionObserver(
      (voci) => {
        if (voci.some((v) => v.isIntersecting)) {
          io.disconnect();
          avvia();
        }
      },
      { threshold: 0.35 }
    );
    io.observe(sez);
  });
</script>

<style>
/* fascia sottile: padding ridotto rispetto a .section */
.stproof {
  padding-block:clamp(2.2rem,4.5vw,3.6rem)
}

.stproof__grid {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:2rem
}

.stproof__item {
  position:relative;
  border-top:1px solid rgba(244,242,238,.2);
  padding-top:1.1rem;
  display:flex;
  align-items:baseline;
  gap:.9rem
}

/* linea del marchio che si disegna sopra il filo grigio */
.stproof__item:before {
  content:"";
  position:absolute;
  left:0;
  top:-1px;
  width:100%;
  height:2px;
  background:var(--accent-light);
  transform:scaleX(0);
  transform-origin:left center;
  transition:transform 1.1s var(--ease);
  transition-delay:calc(var(--i, 0) * 140ms)
}

.stproof.is-on .stproof__item:before {
  transform:scaleX(1)
}

.stproof__item strong {
  display:block;
  flex:none;
  font-family:var(--font-display);
  font-size:clamp(2.1rem,3.3vw,3.2rem);
  line-height:1;
  font-weight:560;
  color:var(--on-dark);
  letter-spacing:-.02em;
  font-variant-numeric:tabular-nums;
  white-space:pre
}

.stproof__item span {
  font-size:.95rem;
  line-height:1.3;
  white-space:nowrap;
  color:var(--on-dark-muted)
}

/* entrata della colonna: sale e appare, sfasata */
.stproof__item strong,
.stproof__item span {
  opacity:0;
  transform:translateY(14px);
  transition:opacity .7s var(--ease),transform .7s var(--ease);
  transition-delay:calc(var(--i, 0) * 140ms)
}

.stproof.is-on .stproof__item strong,
.stproof.is-on .stproof__item span {
  opacity:1;
  transform:none
}

/* senza JS i numeri devono vedersi */
:global(html:not(.js)) .stproof__item strong,
:global(html:not(.js)) .stproof__item span {
  opacity:1;
  transform:none
}

@media(prefers-reduced-motion:reduce) {
  .stproof__item:before {
    transform:none;
    transition:none
  }
  .stproof__item strong,
  .stproof__item span {
    opacity:1;
    transform:none;
    transition:none
  }
}

/* sotto i 1150px l'etichetta accanto al numero non ci sta: va sotto */
@media(max-width:1150px) {
  .stproof__item {
    flex-direction:column;
    gap:.35rem
  }
  .stproof__item span {
    white-space:normal
  }
}

@media(max-width:820px) {
  .stproof__grid {
    grid-template-columns:1fr 1fr;
    gap:1.2rem 1.5rem
  }
}
</style>
