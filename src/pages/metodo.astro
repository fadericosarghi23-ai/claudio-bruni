---
/**
 * Metodo — le tre fasi di lavoro dello studio, tre passi ciascuna.
 * Titoli e voci delle fasi vanno tenuti allineati con STEPS della home.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO } from '../lib/studio';

// [[DA VALIDARE: fasi e descrizioni scritte da noi sui servizi dichiarati dallo studio]]
const PHASES = [
  {
    n: '01',
    title: 'Sopralluogo e verifica',
    cards: [
      {
        t: 'Sopralluogo',
        d: "Rilievo dello stato dei luoghi e prima valutazione di che cosa serve al cliente.",
      },
      {
        t: 'Verifica documentale',
        d: "Raccolta di titoli edilizi, atti e planimetrie presso il Comune e il Catasto.",
      },
      {
        t: 'Conformità',
        d: "Confronto fra stato di fatto, progetto autorizzato e dati catastali, per scoprire subito eventuali difformità.",
      },
    ],
  },
  {
    n: '02',
    title: 'Progetto e pratiche',
    cards: [
      {
        t: 'Progettazione',
        d: "Progetto dell'intervento, calibrato sui vincoli normativi del luogo e sul budget.",
      },
      {
        t: 'Pratiche edilizie',
        d: "Predisposizione e presentazione delle pratiche in Comune, con il coordinamento dei tecnici coinvolti.",
      },
      {
        t: 'Catasto',
        d: "Accatastamenti e variazioni, perché l'immobile risulti in regola anche in Catasto.",
      },
    ],
  },
  {
    n: '03',
    title: 'Cantiere e chiusura',
    cards: [
      {
        t: 'Sicurezza',
        d: "Adempimenti di sicurezza del cantiere, compresa la gestione dei materiali contenenti amianto.",
      },
      {
        t: 'Certificazione energetica',
        d: "Attestato di prestazione energetica (APE) per compravendite, locazioni e fine lavori.",
      },
      {
        t: 'Chiusura',
        d: "Aggiornamento catastale finale e chiusura delle pratiche a lavori conclusi.",
      },
    ],
  },
];
---

<BaseLayout
  title={`Metodo · ${STUDIO.nome}`}
  description="Come lavora lo studio del geometra Claudio Bruni a Imperia: sopralluogo e verifica dei documenti, progetto e pratiche, sicurezza e chiusura del cantiere."
>
  <main id="main">
    <section class="mhead section">
      <div class="container">
        <p class="eyebrow" data-reveal>Il metodo</p>
        <h1 class="display mhead__title" data-reveal>Verificare<br />prima di fare.</h1>
        <p class="lead mhead__lead" data-reveal>
          Ogni incarico parte da un sopralluogo e dal controllo dei documenti dell'immobile: titoli
          edilizi, planimetrie catastali, stato dei luoghi. Solo quando il quadro è chiaro si passa al
          progetto e alle pratiche, che lo studio segue fino alla chiusura, così il cliente sa fin
          dall'inizio che cosa serve, quanto costa e quanto tempo richiede.
        </p>
      </div>
    </section>

    <section class="section msteps section--tint">
      <div class="container">
        {PHASES.map((ph) => (
          <div class="mphase" data-reveal>
            <div class="mphase__head">
              <span class="mphase__n">{ph.n}</span>
              <h2 class="mphase__title">{ph.title}</h2>
            </div>
            <div class="mphase__steps" data-stagger>
              {ph.cards.map((c) => (
                <div class="mcard">
                  <h3 class="mcard__t">{c.t}</h3>
                  <p class="mcard__d muted">{c.d}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.mhead {
  padding-top:calc(var(--header-h) + clamp(2.5rem,6vw,5rem));
  padding-bottom:0
}

.mhead__title {
  margin:1rem 0 1.6rem
}

.mhead__lead {
  max-width:48rem
}

.mphase {
  padding-block:clamp(2.5rem,5vw,4rem);
  border-top:1px solid var(--line)
}

.mphase:first-child {
  border-top:2px solid var(--ink)
}

.mphase__head {
  display:flex;
  align-items:baseline;
  gap:1.2rem;
  margin-bottom:2rem
}

.mphase__n {
  font-family:var(--font-display);
  font-size:clamp(2.5rem,5vw,4rem);
  font-weight:600;
  color:var(--accent);
  line-height:.8;
  letter-spacing:-.03em
}

.mphase__title {
  font-size:clamp(1.6rem,3vw,2.4rem);
  letter-spacing:-.02em
}

.mphase__steps {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:1.5rem
}

.mcard {
  position:relative;
  border-top:1px solid var(--line);
  padding-top:1rem
}

.mcard:before {
  content:"";
  position:absolute;
  top:-1px;
  left:0;
  height:2px;
  width:0;
  background:var(--accent);
  transition:width .5s var(--ease)
}

.mcard:hover:before {
  width:100%
}

.mcard__t {
  font-size:1.05rem;
  margin-bottom:.5rem;
  letter-spacing:-.01em;
  transition:color .3s var(--ease)
}

.mcard:hover .mcard__t {
  color:var(--accent)
}

.mcard__d {
  font-size:.9rem;
  line-height:1.55
}

@media(max-width:820px) {
  .mphase__steps {
    grid-template-columns:1fr 1fr
  }
}

@media(max-width:520px) {
  .mphase__steps {
    grid-template-columns:1fr
  }
}
</style>
