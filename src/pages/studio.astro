---
/**
 * Studio — presentazione, team, pubblicazioni, numeri.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamDeck from '../components/TeamDeck.astro';
import StudioNumeri from '../components/StudioNumeri.astro';
import { STUDIO } from '../lib/studio';
import studioImg from '../assets/studio/studio.jpg';

const progetti = await getCollection('progetti');

// Riferimenti dello studio, dalla scheda Quotalo.
const PUBBLICAZIONI = [
  {
    org: 'Incarichi',
    name: 'Tribunale di Imperia',
    note: 'Consulente Tecnico del Tribunale',
    years: [],
  },
  {
    org: 'Territorio',
    name: 'Imperia e Savona',
    note: 'Le province in cui opera lo studio',
    years: [],
  },
  {
    org: 'Attività',
    name: 'Ufficio tecnico',
    note: 'Servizi in ambito edilizio',
    years: ['dal 1999'],
  },
];

---

<BaseLayout
  title={`Studio · ${STUDIO.nome}`}
  description="Lo studio tecnico del geometra Claudio Bruni nasce a Imperia nel 1999: progettazione, catasto, perizie, sicurezza cantieri e gestione amianto tra Imperia e Savona."
>
  <main id="main">
    <section class="sthead section">
      <div class="container">
        <p class="eyebrow" data-reveal>Lo studio</p>
        {/* [[DA VALIDARE: titolo scritto da noi]] */}
        <h1 class="display sthead__title" data-reveal>Un ufficio tecnico<br />dal 1999.</h1>
      </div>
    </section>

    <section class="stintro">
      <div class="container stintro__grid">
        <div class="stintro__text" data-reveal>
          <p class="lead">
            Lo studio nasce nel 1999 e si propone come ufficio tecnico qualificato, in grado di offrire
            ai propri clienti i servizi richiesti in ambito edilizio.
          </p>
          {/* [[DA VALIDARE: i tre paragrafi che seguono riordinano i dati Quotalo con parole nostre]] */}
          <p class="muted">
            I servizi offerti comprendono progettazione, catasto, sicurezza cantieri, perizie e gestione
            dell'amianto, oltre alla certificazione energetica degli edifici: tutto ciò che serve a chi
            costruisce, ristruttura, compra o vende un immobile, seguito dallo stesso ufficio.
          </p>
          <p class="muted">
            Il geometra Claudio Bruni è Consulente Tecnico del Tribunale di Imperia: un'esperienza che lo
            studio mette a disposizione anche di privati e aziende, nelle perizie tecniche e di stima.
          </p>
          <p class="muted">
            Lo studio ha sede a Imperia, in via A. Lascaris 19, e opera nelle province di Imperia e Savona.
          </p>
        </div>
        <div class="stintro__media">
          <figure class="stintro__frame" data-clip>
            <Image
              src={studioImg}
              alt="Planimetrie e strumenti da disegno (foto stock provvisoria)"
              widths={[500, 800, 1000]}
              sizes="(min-width:900px) 45vw, 90vw"
              loading="lazy"
              class="stintro__img"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="section team section--tint">
      <div class="container">
        <h2 class="h-section team__h" data-reveal>Il titolare</h2>
        <div data-reveal>
          <TeamDeck />
        </div>
      </div>
    </section>

    <section class="section awards">
      <div class="container">
        <p class="eyebrow" data-reveal>Riferimenti</p>
        <h2 class="h-section awards__h" data-reveal>Dove lavoriamo e per chi.</h2>
        <div class="awards__grid" data-stagger>
          {PUBBLICAZIONI.map((a) => (
            <article class="award">
              <span class="award__org">{a.org}</span>
              <h3 class="award__name">{a.name}</h3>
              <p class="award__note muted">{a.note}</p>
              {a.years.length > 0 && (
                <ul class="award__years">
                  {a.years.map((y) => <li>{y}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <StudioNumeri />
  </main>
</BaseLayout>

<style>
.sthead {
  padding-top:calc(var(--header-h) + clamp(2.5rem,6vw,5rem));
  padding-bottom:clamp(1.5rem,3vw,2.5rem)
}

.stintro__grid {
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:clamp(2.5rem,6vw,5rem);
  align-items:stretch
}

.stintro__text > * + * {
  margin-top:1.3rem
}

.stintro__media {
  display:flex
}

.stintro__frame {
  margin:0;
  flex:1 1 auto;
  min-height:320px;
  overflow:hidden;
  background:var(--line)
}

.stintro__img {
  width:100%;
  height:100%;
  object-fit:cover
}

.team__h {
  margin-bottom:clamp(2rem,4vw,3.5rem)
}

.awards__h {
  margin:1rem 0 clamp(2rem,4vw,3rem)
}

.awards__grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2rem
}

.award {
  position:relative;
  border-top:2px solid var(--ink);
  padding-top:1.3rem
}

.award:before {
  content:"";
  position:absolute;
  top:-2px;
  left:0;
  height:2px;
  width:0;
  background:var(--accent);
  transition:width .55s var(--ease)
}

.award:hover:before {
  width:100%
}

.award__org {
  font-size:.74rem;
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--accent)
}

.award__name {
  font-family:var(--font-display);
  font-size:1.6rem;
  letter-spacing:-.02em;
  margin:.5rem 0 .4rem
}

.award__note {
  font-size:.9rem;
  margin:0 0 1.1rem
}

.award__years {
  list-style:none;
  display:flex;
  flex-wrap:wrap;
  gap:.45rem;
  margin:0;
  padding:0
}

.award__years li {
  font-size:.82rem;
  font-weight:500;
  color:var(--ink);
  border:1px solid var(--line-strong);
  padding:.3rem .6rem;
  transition:border-color .3s var(--ease),color .3s var(--ease)
}

.award:hover .award__years li {
  border-color:var(--accent);
  color:var(--accent-deep)
}

@media(max-width:820px) {
  .stintro__grid,.awards__grid {
    grid-template-columns:1fr
  }
}
</style>
